# 이 파일을 복사해서 같은 폴더에 .env 파일을 만들고 값을 채우세요.
# .env 는 GitHub에 올리지 않습니다. (.gitignore 에 포함)

# 공공데이터포털 일반 인증키 (계정당 하나, 여러 API에 공통)
QNET_API_KEY=

# 한국산업인력공단_연도별 회별 국가기술자격 합격률
QNET_API_URL=http://openapi.q-net.or.kr/api/service/rest/InquiryQualPassRateSVC/getList

# 한국산업인력공단_등급별 취득소요기간현황 (조장님 .env 에 있는 값을 그대로 복사)
QNET_TERM_API_URL=

# 한국산업인력공단_국가자격 시험일정 조회 서비스 (비워두면 아래 기본 주소 사용)
# https://apis.data.go.kr/B490007/qualExamSchd 처럼 기능 이름 없이 넣어도 됩니다.
QNET_SCHEDULE_API_URL=https://apis.data.go.kr/B490007/qualExamSchd/getQualExamSchdList
